<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Histórico de Estoque - FlexGestor</title>
    <link rel="stylesheet" href="/css/homeCSS/home.css">
    <link rel="stylesheet" href="/css/menuCSS/menu.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/estoqueCSS/estoque.css">
    <link rel="stylesheet" href="/css/estoqueHistoricoCSS/estoqueHistorico.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body data-rota="EstoqueHistorico">
    <div class="container">
        <div id="menu"></div>
        <main>
            <section class="secao-estoque">
                <div class="cabecalho-tela">
                    <h2><i class="bi bi-clock-history"></i> Movimentações de Estoque</h2>
                    <a href="/Estoque" class="btn-voltar-estoque">
                        <i class="bi bi-arrow-left"></i> Voltar ao Estoque
                    </a>
                </div>

                <div class="table-container">
                    <div class="area-filtro">
                        <input type="text" id="input-busca" class="input-filtro"
                               placeholder="Buscar por produto...">

                        <div class="filtro-status">
                            <button id="btn-filtro-todos" class="btn-status-filtro" onclick="setFiltroTipo('todos')">Todos</button>
                            <button id="btn-filtro-entrada" class="btn-status-filtro" onclick="setFiltroTipo('entrada')">Entrada</button>
                            <button id="btn-filtro-saida" class="btn-status-filtro" onclick="setFiltroTipo('saida')">Saída</button>
                            <button id="btn-filtro-ajuste" class="btn-status-filtro" onclick="setFiltroTipo('ajuste')">Ajuste</button>
                        </div>

                        <div class="filtro-periodo-inline">
                            <span>De</span>
                            <input type="date" id="data-inicio" class="input-filtro" style="width:auto">
                            <span>até</span>
                            <input type="date" id="data-fim" class="input-filtro" style="width:auto">
                        </div>
                    </div>

                    <table class="table-estoque">
                        <thead>
                            <tr>
                                <th>Data/Hora</th>
                                <th>Produto</th>
                                <th>Tipo</th>
                                <th style="text-align:right">Quantidade</th>
                                <th>Usuário</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-historico">
                            <tr><td colspan="6" class="empty-state">Carregando...</td></tr>
                        </tbody>
                    </table>

                    <div class="paginacao">
                        <span class="paginacao-info"></span>
                        <div class="paginacao-controles"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script src="/js/menuJS/menu.js"></script>
    <script src="/js/estoqueHistoricoJS/estoqueHistorico.js"></script>
</body>
</html>