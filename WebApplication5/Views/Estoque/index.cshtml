<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estoque - FlexGestor</title>
    <link rel="stylesheet" href="/css/homeCSS/home.css">
    <link rel="stylesheet" href="/css/menuCSS/menu.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/estoqueCSS/estoque.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body data-rota="Estoque">
    <div class="container">
        <div id="menu"></div>
        <main>
            <section class="secao-estoque">
                <div class="cabecalho-tela">
                    <h2>Controle de Estoque</h2>
                    <div style="display:flex;align-items:center;gap:1.2rem;">
                        <a href="/EstoqueHistorico" class="link-historico">
                            <i class="bi bi-clock-history"></i> Movimentações
                        </a>
                        <a href="/Produto" class="btn-link-produtos">
                            <i class="bi bi-box-seam"></i> Produtos
                        </a>
                        <button class="btn-novo-estoque" onclick="abrirModalInserir()">
                            <i class="bi bi-plus-circle-fill"></i> Inserir no Estoque
                        </button>
                    </div>
                </div>

                <div class="table-container">
                    <div class="area-filtro">
                        <input type="text" id="input-termo-busca" class="input-filtro"
                               placeholder="Buscar por produto..." oninput="filtrarTabela()">
                        <div class="filtro-status">
                            <button id="btn-filtro-todos" class="btn-status-filtro" onclick="setFiltroStatus('todos')">Todos</button>
                            <button id="btn-filtro-critico" class="btn-status-filtro" onclick="setFiltroStatus('critico')">Crítico</button>
                            <button id="btn-filtro-normal" class="btn-status-filtro" onclick="setFiltroStatus('normal')">Normal</button>
                            <button id="btn-filtro-excesso" class="btn-status-filtro" onclick="setFiltroStatus('excesso')">Excesso</button>
                        </div>
                    </div>

                    <table class="table-estoque" id="tabela-estoque">
                        <thead>
                            <tr>
                                <th>Ações</th>
                                <th>Status</th>
                                <th>Produto</th>
                                <th>Qtde Atual</th>
                                <th>Est. Mín</th>
                                <th>Est. Máx</th>
                                <th>SKU</th>
                                <th>Categoria</th>
                                <th>Atualização</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="paginacao">
                        <span class="paginacao-info"></span>
                        <div class="paginacao-controles"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- MODAL: INSERIR NO ESTOQUE (WIZARD 4 ETAPAS) -->
    <div class="modal" id="modal-inserir">
        <div class="modal-content" style="width:60rem">
            <div class="modal-header">
                <h3><i class="bi bi-plus-circle-fill"></i> Inserir Produto no Estoque</h3>
                <button class="btn-fechar-modal" onclick="fecharModalInserir()">&times;</button>
            </div>
            <form id="formInserir">
                <div class="modal-body">
                    <div id="mensagemErro" class="alerta-erro" style="display:none;"></div>
                    <div class="stepper">
                        <div class="step active"><div class="step-circle">1</div></div>
                        <div class="step-line"></div>
                        <div class="step"><div class="step-circle">2</div></div>
                        <div class="step-line"></div>
                        <div class="step"><div class="step-circle">3</div></div>
                        <div class="step-line"></div>
                        <div class="step"><div class="step-circle">4</div></div>
                    </div>

                    <div class="etapa ativa" id="ins-etapa-1">
                        <p class="form-secao">Selecionar Produto</p>
                        <div class="wizard-busca">
                            <i class="bi bi-search"></i>
                            <input type="text" id="ins-busca-produto" placeholder="Buscar por nome ou SKU...">
                        </div>
                        <div class="wizard-lista" id="ins-lista-produtos"></div>
                    </div>

                    <div class="etapa" id="ins-etapa-2">
                        <p class="form-secao">Informações do Estoque</p>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Quantidade Inicial <span class="obrigatorio">*</span></label>
                                <input type="number" id="ins-qtd" min="0" placeholder="0">
                            </div>
                            <div class="form-group">
                                <label>Estoque Mínimo</label>
                                <input type="number" id="ins-min" min="0" placeholder="0">
                            </div>
                            <div class="form-group">
                                <label>Estoque Máximo</label>
                                <input type="number" id="ins-max" min="0" placeholder="0">
                            </div>
                            <div class="form-group">
                                <label>Local / Prateleira</label>
                                <input type="text" id="ins-local" placeholder="ex: Prateleira A1">
                            </div>
                        </div>
                    </div>

                    <div class="etapa" id="ins-etapa-3">
                        <p class="form-secao">Associar Fornecedor <span style="font-size:1.1rem;color:#9ca3af;font-weight:400;text-transform:none;letter-spacing:0">(opcional)</span></p>
                        <div class="wizard-busca">
                            <i class="bi bi-search"></i>
                            <input type="text" id="ins-busca-fornecedor" placeholder="Buscar por nome ou CNPJ...">
                        </div>
                        <div class="wizard-lista" id="ins-lista-fornecedores"></div>
                        <div id="ins-painel-preco" class="painel-preco" style="display:none">
                            <label>Preço de Compra (R$)</label>
                            <input type="number" id="ins-preco-compra" min="0" step="0.01" placeholder="0,00">
                        </div>
                    </div>

                    <div class="etapa" id="ins-etapa-4">
                        <p class="form-secao">Confirmar Inserção</p>
                        <div class="resumo-card">
                            <div class="resumo-secao">Produto Selecionado</div>
                            <div class="resumo-linha"><span>Nome</span><strong id="ins-resumo-produto">—</strong></div>
                            <div class="resumo-linha"><span>SKU</span><strong id="ins-resumo-sku">—</strong></div>
                            <div class="resumo-secao">Estoque</div>
                            <div class="resumo-linha"><span>Quantidade Inicial</span><strong id="ins-resumo-qtd">—</strong></div>
                            <div class="resumo-linha"><span>Estoque Mínimo</span><strong id="ins-resumo-min">—</strong></div>
                            <div class="resumo-linha"><span>Estoque Máximo</span><strong id="ins-resumo-max">—</strong></div>
                            <div class="resumo-linha"><span>Local</span><strong id="ins-resumo-local">—</strong></div>
                            <div id="ins-resumo-bloco-forn" style="display:none">
                                <div class="resumo-secao">Fornecedor</div>
                                <div class="resumo-linha">
                                    <span>Fornecedor</span>
                                    <span class="resumo-forn-badge"><i class="bi bi-building"></i><span id="ins-resumo-fornecedor">—</span></span>
                                </div>
                                <div class="resumo-linha"><span>Preço de Compra</span><strong id="ins-resumo-preco-compra">—</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secundario" id="ins-btn-voltar" style="display:none">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </button>
                    <button type="button" class="btn-primario" id="ins-btn-proximo">
                        Próximo <i class="bi bi-arrow-right"></i>
                    </button>
                    <button type="button" class="btn-primario" id="ins-btn-salvar" style="display:none">
                        <i class="bi bi-check-lg"></i> Confirmar e Inserir
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: MOVIMENTAÇÃO -->
    <div class="modal" id="modal-movimentacao">
        <div class="modal-content" style="width:44rem">
            <div class="modal-header">
                <h3><i class="bi bi-arrow-left-right"></i> Movimentar Estoque</h3>
                <button class="btn-fechar-modal" onclick="fecharModalMovimentacao()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="mov-idProduto">
                <p class="form-secao">Produto</p>
                <p id="mov-produto-nome" style="font-size:1.5rem;font-weight:600;color:#1e3c72;margin-bottom:1.6rem;"></p>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Tipo <span class="obrigatorio">*</span></label>
                        <select id="mov-tipo">
                            <option value="ENTRADA">Entrada</option>
                            <option value="SAIDA">Saída</option>
                            <option value="AJUSTE">Ajuste</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Quantidade <span class="obrigatorio">*</span></label>
                        <input type="number" id="mov-quantidade" min="1" placeholder="0">
                    </div>
                    <div class="form-group form-col-2">
                        <label>Motivo / Observação</label>
                        <input type="text" id="mov-motivo" placeholder="Ex: Compra fornecedor...">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalMovimentacao()">Cancelar</button>
                <button type="button" class="btn-primario" onclick="salvarMovimentacao()">
                    <i class="bi bi-check-lg"></i> Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: CONFIGURAÇÃO DE ESTOQUE (WIZARD 2 ETAPAS) -->
    <div class="modal" id="modal-configuracao">
        <div class="modal-content" style="width:52rem">
            <div class="modal-header">
                <h3><i class="bi bi-bar-chart-fill"></i> Configuração de Estoque</h3>
                <button class="btn-fechar-modal" onclick="fecharModalConfiguracao()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cfg-idProduto">
                <p class="form-secao">Produto</p>
                <p id="cfg-produto-nome" style="font-size:1.5rem;font-weight:600;color:#1e3c72;margin-bottom:1.6rem;"></p>

                <!-- STEPPER -->
                <div class="stepper">
                    <div class="step active" id="cfg-step-1"><div class="step-circle">1</div></div>
                    <div class="step-line" id="cfg-line-1"></div>
                    <div class="step" id="cfg-step-2"><div class="step-circle">2</div></div>
                </div>

                <!-- ETAPA 1: Limites e local -->
                <div class="etapa ativa" id="cfg-etapa-1">
                    <p class="form-secao">Limites de Estoque</p>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Estoque Mínimo <span class="obrigatorio">*</span></label>
                            <input type="number" id="cfg-min" min="0" placeholder="0">
                        </div>
                        <div class="form-group">
                            <label>Estoque Máximo</label>
                            <input type="number" id="cfg-max" min="0" placeholder="0">
                        </div>
                        <div class="form-group form-col-2">
                            <label>Local / Prateleira</label>
                            <input type="text" id="cfg-local" placeholder="ex: Prateleira A1">
                        </div>
                    </div>
                </div>

                <!-- ETAPA 2: Fornecedor -->
                <div class="etapa" id="cfg-etapa-2">
                    <p class="form-secao">Fornecedor <span style="font-size:1.1rem;color:#9ca3af;font-weight:400;text-transform:none;letter-spacing:0">(opcional)</span></p>
                    <div class="wizard-busca">
                        <i class="bi bi-search"></i>
                        <input type="text" id="cfg-busca-fornecedor" placeholder="Buscar por nome ou CNPJ...">
                    </div>
                    <div class="wizard-lista" id="cfg-lista-fornecedores"></div>
                    <div id="cfg-painel-preco" class="painel-preco" style="display:none">
                        <label>Preço de Compra (R$)</label>
                        <input type="number" id="cfg-preco-compra" min="0" step="0.01" placeholder="0,00">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" id="cfg-btn-voltar" style="display:none" onclick="cfgVoltarEtapa()">
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
                <button type="button" class="btn-secundario" onclick="fecharModalConfiguracao()">Cancelar</button>
                <button type="button" class="btn-primario" id="cfg-btn-proximo" onclick="cfgProximaEtapa()">
                    Próximo <i class="bi bi-arrow-right"></i>
                </button>
                <button type="button" class="btn-primario" id="cfg-btn-salvar" style="display:none" onclick="salvarConfiguracao()">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </div>
    </div>

    <script src="/js/menuJS/menu.js"></script>
    <script src="/js/estoqueJS/estoque.js"></script>
</body>
</html>
