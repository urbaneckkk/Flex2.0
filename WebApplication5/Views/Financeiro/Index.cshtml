<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financeiro - FlexGestor</title>
    <link rel="stylesheet" href="/css/homeCSS/home.css">
    <link rel="stylesheet" href="/css/menuCSS/menu.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/financeiroCSS/financeiro.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body data-rota="Financeiro">
    <div class="container">
        <div id="menu"></div>
        <main>
            <section class="secao-financeiro">
                <div class="cabecalho-tela">
                    <h2>Financeiro</h2>
                </div>

                <!-- KPIs -->
                <div class="fin-kpis">
                    <div class="fin-kpi-card">
                        <span class="fin-kpi-label">A Receber</span>
                        <span class="fin-kpi-valor verde" id="kpi-a-receber">—</span>
                        <span class="fin-kpi-sub" id="kpi-a-receber-sub">— contas abertas</span>
                    </div>
                    <div class="fin-kpi-card">
                        <span class="fin-kpi-label">Vencido (Receber)</span>
                        <span class="fin-kpi-valor vermelho" id="kpi-vencido-receber">—</span>
                        <span class="fin-kpi-sub" id="kpi-vencido-receber-sub">— contas vencidas</span>
                    </div>
                    <div class="fin-kpi-card">
                        <span class="fin-kpi-label">A Pagar</span>
                        <span class="fin-kpi-valor laranja" id="kpi-a-pagar">—</span>
                        <span class="fin-kpi-sub" id="kpi-a-pagar-sub">— contas abertas</span>
                    </div>
                    <div class="fin-kpi-card">
                        <span class="fin-kpi-label">Vencido (Pagar)</span>
                        <span class="fin-kpi-valor vermelho" id="kpi-vencido-pagar">—</span>
                        <span class="fin-kpi-sub" id="kpi-vencido-pagar-sub">— contas vencidas</span>
                    </div>
                </div>

                <!-- ABAS -->
                <div class="fin-abas">
                    <button id="aba-btn-receber" class="fin-aba-btn ativa" onclick="mudarAba('receber')">
                        <i class="bi bi-arrow-down-circle-fill"></i> Contas a Receber
                        <span class="fin-aba-badge" id="badge-vencido-receber">0</span>
                    </button>
                    <button id="aba-btn-pagar" class="fin-aba-btn" onclick="mudarAba('pagar')">
                        <i class="bi bi-arrow-up-circle-fill"></i> Contas a Pagar
                        <span class="fin-aba-badge" id="badge-vencido-pagar">0</span>
                    </button>
                    <div style="display:flex;gap:.8rem;margin-left:auto;align-items:center">
                        <button class="btn-nova-conta" style="background:#15803d" onclick="exportar('receber','excel')">
                            <i class="bi bi-file-earmark-excel-fill"></i> Excel
                        </button>
                        <button class="btn-nova-conta" style="background:#dc2626" onclick="exportar('receber','pdf')">
                            <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                        </button>
                    </div>
                </div>

                <!-- ABA RECEBER -->
                <div id="painel-receber" class="table-container" style="border-radius:0 0 1rem 1rem">
                    <div class="area-filtro">
                        <input type="text" id="busca-receber" class="input-filtro"
                               placeholder="Buscar por cliente ou descrição..." oninput="filtrarReceber()">
                        <div class="filtro-status">
                            <button id="fr-todos" class="btn-status-filtro" onclick="setFiltroReceber('todos')">Todos</button>
                            <button id="fr-aberto" class="btn-status-filtro" onclick="setFiltroReceber('aberto')">Aberto</button>
                            <button id="fr-vencido" class="btn-status-filtro" onclick="setFiltroReceber('vencido')">Vencido</button>
                            <button id="fr-pago" class="btn-status-filtro" onclick="setFiltroReceber('pago')">Pago</button>
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem;font-size:1.3rem;color:#6b7280">
                            <span>Vencimento:</span>
                            <input type="date" id="periodo-receber-inicio" class="input-filtro" style="width:15rem"
                                   onchange="setFiltroPeriodo('receber','inicio',this.value)">
                            <span>até</span>
                            <input type="date" id="periodo-receber-fim" class="input-filtro" style="width:15rem"
                                   onchange="setFiltroPeriodo('receber','fim',this.value)">
                        </div>
                        <button class="btn-nova-conta" onclick="abrirModalNovaReceber()">
                            <i class="bi bi-plus-circle-fill"></i> Nova Conta
                        </button>
                    </div>
                    <table class="table-fin" id="tabela-receber">
                        <thead>
                            <tr>
                                <th style="width:16rem">Ações</th>
                                <th style="width:9rem">Status</th>
                                <th>Cliente</th>
                                <th>Descrição</th>
                                <th style="width:12rem;cursor:pointer" onclick="setOrdem('receber','dthVencimento')">Vencimento <i class="bi bi-arrow-down-up" style="opacity:.4;font-size:1rem"></i></th>
                                <th style="width:12rem;cursor:pointer" onclick="setOrdem('receber','valorTotal')">Total <i class="bi bi-arrow-down-up" style="opacity:.4;font-size:1rem"></i></th>
                                <th style="width:12rem">Pago</th>
                                <th style="width:12rem">Restante</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div class="paginacao">
                        <span class="paginacao-info" id="pag-info-receber"></span>
                        <div class="paginacao-controles" id="pag-ctrl-receber"></div>
                    </div>
                </div>

                <!-- ABA PAGAR -->
                <div id="painel-pagar" class="table-container" style="border-radius:0 0 1rem 1rem;display:none">
                    <div class="area-filtro">
                        <input type="text" id="busca-pagar" class="input-filtro"
                               placeholder="Buscar por fornecedor ou descrição..." oninput="filtrarPagar()">
                        <div class="filtro-status">
                            <button id="fp-todos" class="btn-status-filtro" onclick="setFiltroPagar('todos')">Todos</button>
                            <button id="fp-aberto" class="btn-status-filtro" onclick="setFiltroPagar('aberto')">Aberto</button>
                            <button id="fp-vencido" class="btn-status-filtro" onclick="setFiltroPagar('vencido')">Vencido</button>
                            <button id="fp-pago" class="btn-status-filtro" onclick="setFiltroPagar('pago')">Pago</button>
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem;font-size:1.3rem;color:#6b7280">
                            <span>Vencimento:</span>
                            <input type="date" id="periodo-pagar-inicio" class="input-filtro" style="width:15rem"
                                   onchange="setFiltroPeriodo('pagar','inicio',this.value)">
                            <span>até</span>
                            <input type="date" id="periodo-pagar-fim" class="input-filtro" style="width:15rem"
                                   onchange="setFiltroPeriodo('pagar','fim',this.value)">
                        </div>
                        <button class="btn-nova-conta" onclick="abrirModalNovaPagar()">
                            <i class="bi bi-plus-circle-fill"></i> Nova Conta
                        </button>
                    </div>
                    <table class="table-fin" id="tabela-pagar">
                        <thead>
                            <tr>
                                <th style="width:16rem">Ações</th>
                                <th style="width:9rem">Status</th>
                                <th>Fornecedor</th>
                                <th>Descrição</th>
                                <th style="width:12rem;cursor:pointer" onclick="setOrdem('pagar','dthVencimento')">Vencimento <i class="bi bi-arrow-down-up" style="opacity:.4;font-size:1rem"></i></th>
                                <th style="width:12rem;cursor:pointer" onclick="setOrdem('pagar','valorTotal')">Total <i class="bi bi-arrow-down-up" style="opacity:.4;font-size:1rem"></i></th>
                                <th style="width:12rem">Pago</th>
                                <th style="width:12rem">Restante</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div class="paginacao">
                        <span class="paginacao-info" id="pag-info-pagar"></span>
                        <div class="paginacao-controles" id="pag-ctrl-pagar"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- MODAL: NOVA CONTA A RECEBER -->
    <div class="modal" id="modal-nova-receber">
        <div class="modal-content" style="width:48rem">
            <div class="modal-header">
                <h3><i class="bi bi-arrow-down-circle-fill" style="color:#15803d"></i> Nova Conta a Receber</h3>
                <button class="btn-fechar-modal" onclick="fecharModalNovaReceber()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group form-col-2">
                        <label>Cliente <span class="obrigatorio">*</span></label>
                        <select id="nr-cliente"></select>
                    </div>
                    <div class="form-group form-col-2">
                        <label>Descrição</label>
                        <input type="text" id="nr-descricao" placeholder="Ex: Venda a prazo...">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="nr-valor" min="0.01" step="0.01" placeholder="0,00">
                    </div>
                    <div class="form-group">
                        <label>Vencimento <span class="obrigatorio">*</span></label>
                        <input type="date" id="nr-vencimento">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalNovaReceber()">Cancelar</button>
                <button type="button" class="btn-primario verde" onclick="salvarNovaReceber()">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: RECEBER PAGAMENTO -->
    <div class="modal" id="modal-receber-pagamento">
        <div class="modal-content" style="width:44rem">
            <div class="modal-header">
                <h3><i class="bi bi-currency-dollar" style="color:#15803d"></i> Receber Pagamento</h3>
                <button class="btn-fechar-modal" onclick="fecharModalReceberPagamento()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rp-id">
                <input type="hidden" id="rp-restante-raw">
                <div class="receber-info">
                    <span class="receber-label">Cliente</span>
                    <span class="receber-valor" id="rp-cliente">—</span>
                </div>
                <div class="receber-info">
                    <span class="receber-label">Restante</span>
                    <span class="receber-valor vermelho" id="rp-restante">—</span>
                </div>
                <div class="form-grid" style="margin-top:1.6rem">
                    <div class="form-group">
                        <label>Forma de Pagamento <span class="obrigatorio">*</span></label>
                        <select id="rp-forma"></select>
                    </div>
                    <div class="form-group">
                        <label>Valor a Receber (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="rp-valor" min="0.01" step="0.01">
                    </div>
                    <div class="form-group form-col-2">
                        <label>Categoria Financeira <span class="obrigatorio">*</span></label>
                        <select id="rp-categoria"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalReceberPagamento()">Cancelar</button>
                <button type="button" class="btn-primario verde" onclick="confirmarReceber()">
                    <i class="bi bi-check-lg"></i> Confirmar Recebimento
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: ALTERAR VENCIMENTO RECEBER -->
    <div class="modal" id="modal-venc-receber">
        <div class="modal-content" style="width:36rem">
            <div class="modal-header">
                <h3><i class="bi bi-calendar-event"></i> Alterar Vencimento</h3>
                <button class="btn-fechar-modal" onclick="fecharModalVencReceber()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="vr-id">
                <div class="form-group">
                    <label>Nova Data de Vencimento <span class="obrigatorio">*</span></label>
                    <input type="date" id="vr-data">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalVencReceber()">Cancelar</button>
                <button type="button" class="btn-primario" onclick="confirmarVencReceber()">
                    <i class="bi bi-check-lg"></i> Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: EXCLUIR CONTA A RECEBER -->
    <div class="modal" id="modal-excluir-receber">
        <div class="modal-content" style="width:38rem">
            <div class="modal-header">
                <h3><i class="bi bi-exclamation-triangle-fill" style="color:#ef4444"></i> Excluir Conta</h3>
                <button class="btn-fechar-modal" onclick="fecharModalExcluirReceber()">&times;</button>
            </div>
            <div class="confirm-body">
                <div class="confirm-icone"><i class="bi bi-trash-fill"></i></div>
                <p>Deseja excluir esta conta a receber?<br>Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="excluir-r-id">
                <button type="button" class="btn-secundario" onclick="fecharModalExcluirReceber()">Cancelar</button>
                <button type="button" id="btn-confirmar-excluir-r" class="btn-primario vermelho" onclick="confirmarExcluirReceber()">
                    <i class="bi bi-trash-fill"></i> Excluir
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: NOVA CONTA A PAGAR -->
    <div class="modal" id="modal-nova-pagar">
        <div class="modal-content" style="width:48rem">
            <div class="modal-header">
                <h3><i class="bi bi-arrow-up-circle-fill" style="color:#dc2626"></i> Nova Conta a Pagar</h3>
                <button class="btn-fechar-modal" onclick="fecharModalNovaPagar()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group form-col-2">
                        <label>Fornecedor</label>
                        <select id="np-fornecedor"><option value="">Nenhum</option></select>
                    </div>
                    <div class="form-group form-col-2">
                        <label>Descrição <span class="obrigatorio">*</span></label>
                        <input type="text" id="np-descricao" placeholder="Ex: Compra de mercadoria...">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="np-valor" min="0.01" step="0.01" placeholder="0,00">
                    </div>
                    <div class="form-group">
                        <label>Vencimento <span class="obrigatorio">*</span></label>
                        <input type="date" id="np-vencimento">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalNovaPagar()">Cancelar</button>
                <button type="button" class="btn-primario" onclick="salvarNovaPagar()">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: PAGAR CONTA -->
    <div class="modal" id="modal-pagar-conta">
        <div class="modal-content" style="width:44rem">
            <div class="modal-header">
                <h3><i class="bi bi-cash-coin" style="color:#d97706"></i> Registrar Pagamento</h3>
                <button class="btn-fechar-modal" onclick="fecharModalPagarConta()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pc-id">
                <input type="hidden" id="pc-restante-raw">
                <div class="receber-info">
                    <span class="receber-label">Fornecedor</span>
                    <span class="receber-valor" id="pc-fornecedor">—</span>
                </div>
                <div class="receber-info">
                    <span class="receber-label">Restante</span>
                    <span class="receber-valor vermelho" id="pc-restante">—</span>
                </div>
                <div class="form-grid" style="margin-top:1.6rem">
                    <div class="form-group">
                        <label>Forma de Pagamento <span class="obrigatorio">*</span></label>
                        <select id="pc-forma"></select>
                    </div>
                    <div class="form-group">
                        <label>Valor a Pagar (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="pc-valor" min="0.01" step="0.01">
                    </div>
                    <div class="form-group form-col-2">
                        <label>Categoria Financeira <span class="obrigatorio">*</span></label>
                        <select id="pc-categoria"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalPagarConta()">Cancelar</button>
                <button type="button" class="btn-primario" onclick="confirmarPagar()">
                    <i class="bi bi-check-lg"></i> Confirmar Pagamento
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: ALTERAR VENCIMENTO PAGAR -->
    <div class="modal" id="modal-venc-pagar">
        <div class="modal-content" style="width:36rem">
            <div class="modal-header">
                <h3><i class="bi bi-calendar-event"></i> Alterar Vencimento</h3>
                <button class="btn-fechar-modal" onclick="fecharModalVencPagar()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="vp-id">
                <div class="form-group">
                    <label>Nova Data de Vencimento <span class="obrigatorio">*</span></label>
                    <input type="date" id="vp-data">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalVencPagar()">Cancelar</button>
                <button type="button" class="btn-primario" onclick="confirmarVencPagar()">
                    <i class="bi bi-check-lg"></i> Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: EXCLUIR CONTA A PAGAR -->
    <div class="modal" id="modal-excluir-pagar">
        <div class="modal-content" style="width:38rem">
            <div class="modal-header">
                <h3><i class="bi bi-exclamation-triangle-fill" style="color:#ef4444"></i> Excluir Conta</h3>
                <button class="btn-fechar-modal" onclick="fecharModalExcluirPagar()">&times;</button>
            </div>
            <div class="confirm-body">
                <div class="confirm-icone"><i class="bi bi-trash-fill"></i></div>
                <p>Deseja excluir esta conta a pagar?<br>Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="excluir-p-id">
                <button type="button" class="btn-secundario" onclick="fecharModalExcluirPagar()">Cancelar</button>
                <button type="button" id="btn-confirmar-excluir-p" class="btn-primario vermelho" onclick="confirmarExcluirPagar()">
                    <i class="bi bi-trash-fill"></i> Excluir
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: EDITAR CONTA A RECEBER -->
    <div class="modal" id="modal-editar-receber">
        <div class="modal-content" style="width:46rem">
            <div class="modal-header">
                <h3><i class="bi bi-pencil-fill"></i> Editar Conta a Receber</h3>
                <button class="btn-fechar-modal" onclick="fecharModalEditarReceber()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="er-id">
                <div class="form-grid">
                    <div class="form-group form-col-2">
                        <label>Cliente <span class="obrigatorio">*</span></label>
                        <select id="er-cliente"></select>
                    </div>
                    <div class="form-group form-col-2">
                        <label>Descrição</label>
                        <input type="text" id="er-descricao" placeholder="Ex: Venda a prazo...">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="er-valor" min="0.01" step="0.01">
                    </div>
                    <div class="form-group">
                        <label>Vencimento <span class="obrigatorio">*</span></label>
                        <input type="date" id="er-vencimento">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secundario" onclick="fecharModalEditarReceber()">Cancelar</button>
                <button class="btn-primario verde" onclick="salvarEditarReceber()">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: EDITAR CONTA A PAGAR -->
    <div class="modal" id="modal-editar-pagar">
        <div class="modal-content" style="width:46rem">
            <div class="modal-header">
                <h3><i class="bi bi-pencil-fill"></i> Editar Conta a Pagar</h3>
                <button class="btn-fechar-modal" onclick="fecharModalEditarPagar()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ep-id">
                <div class="form-grid">
                    <div class="form-group form-col-2">
                        <label>Fornecedor</label>
                        <select id="ep-fornecedor"><option value="">Nenhum</option></select>
                    </div>
                    <div class="form-group form-col-2">
                        <label>Descrição <span class="obrigatorio">*</span></label>
                        <input type="text" id="ep-descricao">
                    </div>
                    <div class="form-group">
                        <label>Valor Total (R$) <span class="obrigatorio">*</span></label>
                        <input type="number" id="ep-valor" min="0.01" step="0.01">
                    </div>
                    <div class="form-group">
                        <label>Vencimento <span class="obrigatorio">*</span></label>
                        <input type="date" id="ep-vencimento">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secundario" onclick="fecharModalEditarPagar()">Cancelar</button>
                <button class="btn-primario" onclick="salvarEditarPagar()">
                    <i class="bi bi-check-lg"></i> Salvar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: HISTÓRICO -->
    <div class="modal" id="modal-historico">W
        <div class="modal-content" style="width:46rem">
            <div class="modal-header">
                <h3><i class="bi bi-clock-history"></i> <span id="hist-titulo">Histórico</span></h3>
                <button class="btn-fechar-modal" onclick="fecharHistorico()">&times;</button>
            </div>
            <div class="modal-body" id="hist-corpo"></div>
            <div class="modal-footer">
                <button class="btn-secundario" onclick="fecharHistorico()">Fechar</button>
            </div>
        </div>
    </div>

    <script src="/js/menuJS/menu.js"></script>
    <script src="/js/financeiroJS/financeiro.js"></script>
</body>
</html>
WWWW