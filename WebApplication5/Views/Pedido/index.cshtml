@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos - FlexGestor</title>
    <link rel="stylesheet" href="/css/homeCSS/home.css">
    <link rel="stylesheet" href="/css/menuCSS/menu.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/pedidoCSS/pedido.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body data-rota="Pedido">
    <div class="container">
        <div id="menu"></div>
        <main>
            <section class="secao-pedidos">

                <div class="cabecalho-tela">
                    <h2>Pedidos</h2>
                    <button class="btn-novo-pedido" onclick="abrirModalNovoPedido()">
                        <i class="bi bi-plus-circle-fill"></i> Novo Pedido
                    </button>
                </div>

                <div class="table-container">
                    <div class="area-filtro">
                        <input type="text" id="input-busca-cliente" class="input-filtro"
                               placeholder="Buscar por cliente ou nº do pedido..."
                               oninput="filtrarCliente()">
                        <div class="filtro-status">
                            <button id="btn-f-todos" class="btn-status-filtro" onclick="setFiltroStatus('todos')">Todos</button>
                            <button id="btn-f-pendente" class="btn-status-filtro" onclick="setFiltroStatus('pendente')">Pendente</button>
                            <button id="btn-f-confirmado" class="btn-status-filtro" onclick="setFiltroStatus('confirmado')">Confirmado</button>
                            <button id="btn-f-separando" class="btn-status-filtro" onclick="setFiltroStatus('separando')">Separando</button>
                            <button id="btn-f-enviado" class="btn-status-filtro" onclick="setFiltroStatus('enviado')">Enviado</button>
                            <button id="btn-f-concluido" class="btn-status-filtro" onclick="setFiltroStatus('concluido')">Concluído</button>
                            <button id="btn-f-cancelado" class="btn-status-filtro" onclick="setFiltroStatus('cancelado')">Cancelado</button>
                        </div>
                    </div>

                    <table class="table-pedidos" id="tabela-pedidos">
                        <thead>
                            <tr>
                                <th>Ações</th>
                                <th>Nº Pedido</th>
                                <th>Data</th>
                                <th>Cliente</th>
                                <th>Status</th>
                                <th>Itens</th>
                                <th>Desconto</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="paginacao">
                        <span class="paginacao-info"></span>
                        <div class="paginacao-controles"></div>
                    </div>
                </div>

            </section>
        </main>
    </div>

    <!-- ══════════════════════════════════════════
         MODAL: NOVO / EDITAR PEDIDO
    ══════════════════════════════════════════ -->
    <div class="modal" id="modal-pedido">
        <div class="modal-content modal-xl">
            <div class="modal-header">
                <h3 id="modal-pedido-titulo"><i class="bi bi-bag-plus-fill"></i> Novo Pedido</h3>
                <button class="btn-fechar-modal" onclick="fecharModalPedido()">&times;</button>
            </div>

            <!-- ABAS DO MODAL -->
            <div class="modal-tabs">
                <button class="tab-btn ativo" id="tab-dados-btn" onclick="mudarTabPedido('dados')">
                    <i class="bi bi-card-text"></i> Dados
                </button>
                <button class="tab-btn" id="tab-itens-btn" onclick="mudarTabPedido('itens')">
                    <i class="bi bi-box-seam"></i> Itens
                </button>
                <button class="tab-btn" id="tab-pagamento-btn" onclick="mudarTabPedido('pagamento')">
                    <i class="bi bi-credit-card-fill"></i> Pagamento
                </button>
            </div>

            <div class="modal-body">

                <!-- ABA DADOS -->
                <div id="tab-dados" class="tab-painel ativo">
                    <p class="form-secao">Cliente</p>
                    <div class="form-grid">
                        <div class="form-group form-col-2">
                            <label>Cliente <span class="obrigatorio">*</span></label>
                            <div class="cliente-selecionado-wrap">
                                <input type="hidden" id="pedido-id-cliente">
                                <input type="text" id="pedido-nome-cliente" readonly
                                       placeholder="Clique em buscar para selecionar um cliente...">
                                <button type="button" class="btn-buscar-cliente"
                                        onclick="abrirBuscaCliente()">
                                    <i class="bi bi-search"></i> Buscar
                                </button>
                            </div>
                        </div>
                    </div>

                    <p class="form-secao">Informações do Pedido</p>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Canal de Venda</label>
                            <select id="pedido-canal">
                                <option value="LOJA">Loja Física</option>
                                <option value="WHATSAPP">WhatsApp</option>
                                <option value="SITE">Site</option>
                                <option value="MERCADOLIVRE">Mercado Livre</option>
                                <option value="OUTROS">Outros</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Previsão de Entrega</label>
                            <input type="date" id="pedido-previsao">
                        </div>
                        <div class="form-group form-col-2">
                            <label>Observação</label>
                            <textarea id="pedido-obs" placeholder="Observações internas sobre o pedido..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- ABA ITENS -->
                <div id="tab-itens" class="tab-painel">
                    <div class="itens-header">
                        <span>Produtos do Pedido</span>
                        <button type="button" class="btn-add-item" onclick="adicionarItemPedido()">
                            <i class="bi bi-plus-lg"></i> Adicionar Item
                        </button>
                    </div>
                    <table class="table-itens">
                        <thead>
                            <tr>
                                <th class="col-produto">Produto</th>
                                <th class="col-qtde">Qtde</th>
                                <th class="col-preco">Preço Unit.</th>
                                <th class="col-desc">Desconto</th>
                                <th class="col-sub">Subtotal</th>
                                <th class="col-del"></th>
                            </tr>
                        </thead>
                        <tbody id="itens-body"></tbody>
                    </table>

                    <div class="pedido-resumo">
                        <div class="pedido-resumo-linha">
                            <span>Subtotal</span>
                            <span id="resumo-subtotal">R$ 0,00</span>
                        </div>
                        <div class="pedido-resumo-linha">
                            <span>Desconto Total</span>
                            <span id="resumo-desconto" style="color:#dc2626">-R$ 0,00</span>
                        </div>
                        <div class="pedido-resumo-linha total">
                            <span>Total do Pedido</span>
                            <span id="resumo-total">R$ 0,00</span>
                        </div>
                    </div>
                </div>

                <!-- ABA PAGAMENTO -->
                <div id="tab-pagamento" class="tab-painel">
                    <div class="pag-header">
                        <p class="form-secao" style="margin:0;border:none">Formas de Pagamento</p>
                        <button type="button" class="btn-add-item" onclick="adicionarPagamento()">
                            <i class="bi bi-plus-lg"></i> Adicionar Pagamento
                        </button>
                    </div>

                    <div class="pagamentos-lista" id="pagamentos-lista">
                        <div class="pagamentos-empty">
                            <i class="bi bi-credit-card"></i>
                            Nenhum pagamento adicionado
                        </div>
                    </div>

                    <div class="pagamentos-resumo-grid">
                        <div class="pag-resumo-item">
                            <span class="pag-resumo-label"><i class="bi bi-receipt"></i> Total do Pedido</span>
                            <span class="pag-resumo-valor" id="pag-total-pedido">R$ 0,00</span>
                        </div>
                        <div class="pag-resumo-item pag-resumo-quitado">
                            <span class="pag-resumo-label"><i class="bi bi-check-circle-fill"></i> Valor Pago</span>
                            <span class="pag-resumo-valor" id="pag-valor-pago">R$ 0,00</span>
                        </div>
                        <div class="pag-resumo-item pag-resumo-pendente" id="pag-resumo-pendente-item">
                            <span class="pag-resumo-label"><i class="bi bi-clock-fill"></i> Pendente</span>
                            <span class="pag-resumo-valor" id="pag-valor-pendente">R$ 0,00</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalPedido()">Cancelar</button>
                <button type="button" class="btn-primario" id="btn-salvar-pedido" onclick="salvarPedido()">
                    <i class="bi bi-check-lg"></i> Salvar Pedido
                </button>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         MODAL: DETALHES DO PEDIDO
    ══════════════════════════════════════════ -->
    <div class="modal" id="modal-detalhe-pedido">
        <div class="modal-content modal-xl">
            <div class="modal-header">
                <h3 id="detalhe-titulo"><i class="bi bi-bag-check-fill"></i> Pedido</h3>
                <button class="btn-fechar-modal" onclick="fecharModalDetalhe()">&times;</button>
            </div>

            <div class="modal-tabs">
                <button class="tab-btn ativo" id="det-tab-resumo-btn" onclick="mudarTabDetalhe('resumo')">
                    <i class="bi bi-info-circle-fill"></i> Resumo
                </button>
                <button class="tab-btn" id="det-tab-historico-btn" onclick="mudarTabDetalhe('historico')">
                    <i class="bi bi-clock-history"></i> Histórico
                </button>
                <button class="tab-btn" id="det-tab-pagamentos-btn" onclick="mudarTabDetalhe('pagamentos')">
                    <i class="bi bi-credit-card-fill"></i> Pagamentos
                </button>
            </div>

            <div class="modal-body">

                <!-- RESUMO -->
                <div id="det-tab-resumo" class="tab-painel ativo">
                    <div class="detalhe-grid">
                        <div class="detalhe-item">
                            <label>Número</label>
                            <span id="det-numero">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Status</label>
                            <span id="det-status">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Cliente</label>
                            <span id="det-cliente">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Canal</label>
                            <span id="det-canal">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Data</label>
                            <span id="det-data">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Previsão Entrega</label>
                            <span id="det-previsao">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Total</label>
                            <span id="det-total" style="font-weight:700;font-size:1.6rem;color:#1e3c72">—</span>
                        </div>
                        <div class="detalhe-item">
                            <label>Observação</label>
                            <span id="det-obs">—</span>
                        </div>
                    </div>

                    <p class="form-secao">Itens do Pedido</p>
                    <table class="table-itens">
                        <thead>
                            <tr>
                                <th class="col-produto">Produto</th>
                                <th class="col-qtde">Qtde</th>
                                <th class="col-preco">Preço Unit.</th>
                                <th class="col-desc">Desconto</th>
                                <th class="col-sub">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="det-itens-body"></tbody>
                    </table>

                    <p class="form-secao" style="margin-top:2rem">Atualizar Status</p>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Novo Status</label>
                            <select id="det-novo-status">
                                <option value="1">Pendente</option>
                                <option value="2">Confirmado</option>
                                <option value="3">Separando</option>
                                <option value="4">Enviado</option>
                                <option value="5">Concluído</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Observação da Mudança</label>
                            <input type="text" id="det-obs-status" placeholder="Motivo ou observação...">
                        </div>
                    </div>
                </div>

                <!-- HISTÓRICO -->
                <div id="det-tab-historico" class="tab-painel">
                    <div class="historico-timeline" id="historico-timeline">
                        <div class="empty-state">Nenhum histórico disponível.</div>
                    </div>
                </div>

                <!-- PAGAMENTOS -->
                <div id="det-tab-pagamentos" class="tab-painel">
                    <div id="det-pagamentos-lista"></div>
                    <div class="det-pagamentos-rodape">
                        <span>Total do pedido: <strong id="det-pag-total">—</strong></span>
                        <span>Pago: <strong id="det-pag-pago" style="color:#15803d">—</strong></span>
                        <span>Pendente: <strong id="det-pag-pendente" style="color:#d97706">—</strong></span>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secundario" onclick="fecharModalDetalhe()">Fechar</button>
                <button type="button" class="btn-primario" onclick="atualizarStatusPedido()">
                    <i class="bi bi-arrow-repeat"></i> Atualizar Status
                </button>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         MODAL: CANCELAR PEDIDO
    ══════════════════════════════════════════ -->
    <div class="modal" id="modal-cancelar-pedido">
        <div class="modal-content" style="width:48rem">
            <div class="modal-header">
                <h3><i class="bi bi-x-circle-fill" style="color:#dc2626"></i> Cancelar Pedido</h3>
                <button class="btn-fechar-modal" onclick="fecharModalCancelar()">&times;</button>
            </div>
            <div class="confirm-body">
                <div class="confirm-icone"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <p>Deseja cancelar o pedido <strong id="cancelar-numero">—</strong>?<br>Esta ação não pode ser desfeita.</p>
            </div>
            <div class="form-grid" style="padding:0 2.4rem 1.6rem">
                <div class="form-group form-col-2">
                    <label>Motivo do Cancelamento</label>
                    <input type="text" id="cancelar-motivo" placeholder="Descreva o motivo...">
                </div>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="cancelar-id-pedido">
                <button type="button" class="btn-secundario" onclick="fecharModalCancelar()">Não, voltar</button>
                <button type="button" class="btn-perigo" onclick="confirmarCancelarPedido()">
                    <i class="bi bi-x-circle-fill"></i> Sim, cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         MODAL: BUSCA DE CLIENTE
    ══════════════════════════════════════════ -->
    <div class="modal modal-busca" id="modal-busca-cliente">
        <div class="busca-modal-content">
            <div class="modal-header">
                <h3><i class="bi bi-people-fill"></i> Buscar Cliente</h3>
                <button class="btn-fechar-modal" onclick="fecharBuscaCliente()">&times;</button>
            </div>
            <div class="busca-input-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="input-busca-cliente-modal"
                       placeholder="Buscar por nome ou CPF/CNPJ..."
                       oninput="filtrarListaClientes(this.value)">
            </div>
            <div class="busca-lista" id="lista-busca-clientes"></div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         MODAL: BUSCA DE PRODUTO
    ══════════════════════════════════════════ -->
    <div class="modal modal-busca" id="modal-busca-produto">
        <div class="busca-modal-content">
            <div class="modal-header">
                <h3><i class="bi bi-box-seam"></i> Buscar Produto</h3>
                <button class="btn-fechar-modal" onclick="fecharBuscaProduto()">&times;</button>
            </div>
            <div class="busca-input-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="input-busca-produto-modal"
                       placeholder="Buscar por nome ou SKU..."
                       oninput="filtrarListaProdutos(this.value)">
            </div>
            <div class="busca-lista" id="lista-busca-produtos"></div>
        </div>
    </div>

    <script src="/js/menuJS/menu.js"></script>
    <script src="/js/pedidoJS/pedido.js"></script>
</body>
</html>
