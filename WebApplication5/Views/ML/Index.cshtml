<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Inteligência Artificial - FlexGestor</title>
    <link rel="stylesheet" href="/css/homeCSS/home.css">
    <link rel="stylesheet" href="/css/menuCSS/menu.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .ml-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2.4rem;
        }

        .ml-card {
            background: #fff;
            border-radius: 1rem;
            padding: 2rem;
            box-shadow: 0 .1rem .4rem rgba(0,0,0,.07);
            border: 1px solid #f0f2f5;
        }

        .ml-card-titulo {
            font-size: 1.1rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: .06rem;
            margin-bottom: 1.6rem;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .ml-card-titulo i {
                font-size: 1.4rem;
            }

        .btn-insight {
            display: flex;
            align-items: center;
            gap: .6rem;
            background: #1e3c72;
            color: #fff;
            border: none;
            padding: .8rem 1.6rem;
            border-radius: .6rem;
            font-size: 1.3rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
            font-family: 'Segoe UI', sans-serif;
        }

            .btn-insight:hover {
                background: #254a8f;
            }

            .btn-insight:disabled {
                opacity: .6;
                cursor: not-allowed;
            }

            .btn-insight.verde {
                background: #15803d;
            }

                .btn-insight.verde:hover {
                    background: #166534;
                }

            .btn-insight.laranja {
                background: #d97706;
            }

                .btn-insight.laranja:hover {
                    background: #b45309;
                }

        .insight-box {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: .8rem;
            padding: 1.6rem;
            margin-top: 1.2rem;
            font-size: 1.3rem;
            color: #374151;
            line-height: 1.8;
            white-space: pre-wrap;
            min-height: 8rem;
            font-family: 'Segoe UI', sans-serif;
        }

            .insight-box.carregando {
                color: #9ca3af;
                font-style: italic;
            }

        .tabela-ml {
            width: 100%;
            border-collapse: collapse;
            font-size: 1.3rem;
        }

            .tabela-ml th {
                text-align: left;
                padding: .8rem 1rem;
                font-size: 1.1rem;
                font-weight: 700;
                color: #1e3c72;
                text-transform: uppercase;
                letter-spacing: .04rem;
                border-bottom: 2px solid #eaecf0;
                background: #f7f9fc;
            }

            .tabela-ml td {
                padding: .8rem 1rem;
                border-bottom: 1px solid #f0f2f5;
                color: #374151;
            }

            .tabela-ml tbody tr:hover td {
                background: #eef2fb;
            }

        .risco-baixo {
            background: #dcfce7;
            color: #15803d;
            padding: .2rem .8rem;
            border-radius: 2rem;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .risco-medio {
            background: #fef3c7;
            color: #92400e;
            padding: .2rem .8rem;
            border-radius: 2rem;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .risco-alto {
            background: #fee2e2;
            color: #b91c1c;
            padding: .2rem .8rem;
            border-radius: 2rem;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .gauge-bar {
            height: .6rem;
            background: #f0f2f5;
            border-radius: 1rem;
            overflow: hidden;
            margin-top: .4rem;
        }

        .gauge-fill {
            height: 100%;
            border-radius: 1rem;
            background: #1e3c72;
            transition: width .6s ease;
        }

        .atualizado-em {
            font-size: 1.1rem;
            color: #9ca3af;
            margin-left: auto;
        }

        .ml-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.6rem;
            margin-bottom: 2.4rem;
        }

        .ml-kpi {
            background: #fff;
            border-radius: 1rem;
            padding: 1.6rem 2rem;
            border: 1px solid #f0f2f5;
            box-shadow: 0 .1rem .4rem rgba(0,0,0,.05);
        }

        .ml-kpi-label {
            font-size: 1.1rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: .06rem;
        }

        .ml-kpi-valor {
            font-size: 2.2rem;
            font-weight: 700;
            color: #1e3c72;
            margin-top: .4rem;
        }

        .ml-kpi-sub {
            font-size: 1.2rem;
            color: #6b7280;
            margin-top: .2rem;
        }

        .secao-titulo {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1e3c72;
            margin: 2.4rem 0 1.2rem;
            display: flex;
            align-items: center;
            gap: .8rem;
        }
    </style>
</head>
<body data-rota="ML">
    <div class="container">
        <div id="menu"></div>
        <main>
            <section class="secao-pagina">
                <div class="cabecalho-tela">
                    <h2><i class="bi bi-graph-up-arrow"></i> Inteligência de Negócios</h2>
                    <div style="display:flex;align-items:center;gap:1.2rem">
                        <span class="atualizado-em" id="atualizado-em">Carregando...</span>
                        <button class="btn-insight" onclick="recarregar()">
                            <i class="bi bi-arrow-clockwise"></i> Atualizar dados
                        </button>
                    </div>
                </div>

                <!-- KPIs rápidos -->
                <div class="ml-kpis" id="ml-kpis">
                    <div class="ml-kpi"><div class="ml-kpi-label">Produtos em alerta</div><div class="ml-kpi-valor" id="kpi-alertas">—</div><div class="ml-kpi-sub">estoque crítico</div></div>
                    <div class="ml-kpi"><div class="ml-kpi-label">Clientes em risco</div><div class="ml-kpi-valor" id="kpi-churn">—</div><div class="ml-kpi-sub">sem comprar há 90+ dias</div></div>
                    <div class="ml-kpi"><div class="ml-kpi-label">Saldo projetado</div><div class="ml-kpi-valor" id="kpi-saldo">—</div><div class="ml-kpi-sub">receber − pagar</div></div>
                    <div class="ml-kpi"><div class="ml-kpi-label">Ticket médio</div><div class="ml-kpi-valor" id="kpi-ticket">—</div><div class="ml-kpi-sub">último mês</div></div>
                </div>

                <!-- Grid de análises IA -->
                <div class="ml-grid">

                    <!-- Demanda -->
                    <div class="ml-card">
                        <div class="ml-card-titulo" style="color:#1e3c72">
                            <i class="bi bi-boxes" style="color:#1e3c72"></i> Previsão de Demanda
                        </div>
                        <p style="font-size:1.3rem;color:#6b7280;margin-bottom:1.2rem">Análise de velocidade de venda e risco de ruptura baseada nos últimos 90 dias.</p>
                        <button class="btn-insight" onclick="gerarInsight('demanda', this)">
                            <i class="bi bi-stars"></i> Gerar análise IA
                        </button>
                        <div class="insight-box" id="insight-demanda">Clique em "Gerar análise IA" para obter previsões baseadas nos seus dados reais.</div>
                    </div>

                    <!-- Churn -->
                    <div class="ml-card">
                        <div class="ml-card-titulo" style="color:#15803d">
                            <i class="bi bi-people-fill" style="color:#15803d"></i> Risco de Churn
                        </div>
                        <p style="font-size:1.3rem;color:#6b7280;margin-bottom:1.2rem">Identifica clientes com padrão de abandono baseado no histórico de compras.</p>
                        <button class="btn-insight verde" onclick="gerarInsight('churn', this)">
                            <i class="bi bi-stars"></i> Gerar análise IA
                        </button>
                        <div class="insight-box" id="insight-churn">Clique em "Gerar análise IA" para identificar clientes em risco.</div>
                    </div>

                    <!-- Financeiro -->
                    <div class="ml-card">
                        <div class="ml-card-titulo" style="color:#d97706">
                            <i class="bi bi-bank" style="color:#d97706"></i> Saúde Financeira
                        </div>
                        <p style="font-size:1.3rem;color:#6b7280;margin-bottom:1.2rem">Diagnóstico do fluxo de caixa e projeção financeira com base nas contas abertas.</p>
                        <button class="btn-insight laranja" onclick="gerarInsight('financeiro', this)">
                            <i class="bi bi-stars"></i> Gerar análise IA
                        </button>
                        <div class="insight-box" id="insight-financeiro">Clique em "Gerar análise IA" para o diagnóstico financeiro.</div>
                    </div>
                </div>

                <!-- Tabela: Estoque crítico -->
                <div class="secao-titulo"><i class="bi bi-exclamation-triangle-fill" style="color:#dc2626"></i> Estoque em Alerta</div>
                <div class="ml-card" style="padding:0;overflow:hidden">
                    <table class="tabela-ml" id="tabela-estoque-ml">
                        <thead><tr><th>Produto</th><th>Qtde Atual</th><th>Mínimo</th><th>Dias para Zerar</th><th>Urgência</th></tr></thead>
                        <tbody><tr><td colspan="5" style="text-align:center;padding:2rem;color:#9ca3af">Carregando...</td></tr></tbody>
                    </table>
                </div>

                <!-- Tabela: Clientes em risco -->
                <div class="secao-titulo"><i class="bi bi-person-x-fill" style="color:#d97706"></i> Clientes em Risco de Churn</div>
                <div class="ml-card" style="padding:0;overflow:hidden">
                    <table class="tabela-ml" id="tabela-churn-ml">
                        <thead><tr><th>Cliente</th><th>Total Pedidos</th><th>Total Gasto</th><th>Dias sem Comprar</th><th>Risco</th></tr></thead>
                        <tbody><tr><td colspan="5" style="text-align:center;padding:2rem;color:#9ca3af">Carregando...</td></tr></tbody>
                    </table>
                </div>

                <!-- Gráfico: Faturamento mensal -->
                <div class="secao-titulo"><i class="bi bi-bar-chart-fill"></i> Faturamento Mensal</div>
                <div class="ml-card">
                    <div id="grafico-faturamento" style="display:flex;align-items:flex-end;gap:1.2rem;height:16rem"></div>
                </div>

            </section>
        </main>
    </div>

    <script src="/js/menuJS/menu.js"></script>
    <script>
        let dadosML = null;

        async function carregarDados() {
            try {
                const res = await fetch("/ML/Dados");
                dadosML = await res.json();
                renderizarDados();
                document.getElementById("atualizado-em").textContent =
                    "Atualizado em " + new Date().toLocaleTimeString("pt-BR");
            } catch(err) {
                console.error("Erro ao carregar dados ML:", err);
            }
        }

        function fmt(v) {
            return "R$ " + Number(v ?? 0).toLocaleString("pt-BR", { minimumFractionDigits: 2 });
        }

        function renderizarDados() {
            const d = dadosML;

            // KPIs
            document.getElementById("kpi-alertas").textContent = d.estoqueCritico?.length ?? 0;
            document.getElementById("kpi-churn").textContent =
                d.clientes?.filter(c => c.riscoChurn === "Alto").length ?? 0;
            document.getElementById("kpi-saldo").textContent = fmt(d.financeiro?.saldoProjetado);
            const ultimoMes = d.vendasMensais?.[d.vendasMensais.length - 1];
            document.getElementById("kpi-ticket").textContent = fmt(ultimoMes?.ticketMedio);

            // Tabela estoque
            const tbE = document.querySelector("#tabela-estoque-ml tbody");
            if (d.estoqueCritico?.length) {
                tbE.innerHTML = d.estoqueCritico.map(e => {
                    const urgencia = e.diasParaZerar < 7 ? "🔴 Urgente" :
                                     e.diasParaZerar < 15 ? "🟡 Atenção" : "🟢 Monitorar";
                    return `<tr>
                        <td><strong>${e.produto}</strong></td>
                        <td>${e.quantidade}</td>
                        <td>${e.minimo}</td>
                        <td>${e.diasParaZerar === 999 ? "Sem vendas" : e.diasParaZerar + " dias"}</td>
                        <td>${urgencia}</td>
                    </tr>`;
                }).join("");
            } else {
                tbE.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:2rem;color:#15803d">✓ Nenhum produto em alerta crítico</td></tr>`;
            }

            // Tabela churn
            const tbC = document.querySelector("#tabela-churn-ml tbody");
            const emRisco = d.clientes?.filter(c => c.riscoChurn !== "Baixo") ?? [];
            if (emRisco.length) {
                tbC.innerHTML = emRisco.slice(0, 10).map(c => `<tr>
                    <td><strong>${c.nome}</strong></td>
                    <td>${c.totalPedidos}</td>
                    <td>${fmt(c.totalGasto)}</td>
                    <td>${c.diasDesdeUltimaCompra}</td>
                    <td><span class="risco-${c.riscoChurn.toLowerCase()}">${c.riscoChurn}</span></td>
                </tr>`).join("");
            } else {
                tbC.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:2rem;color:#15803d">✓ Nenhum cliente em risco</td></tr>`;
            }

            // Gráfico faturamento
            const graf = document.getElementById("grafico-faturamento");
            const meses = d.vendasMensais ?? [];
            if (meses.length) {
                const maxVal = Math.max(...meses.map(m => m.faturamento));
                graf.innerHTML = meses.map(m => {
                    const pct = maxVal > 0 ? (m.faturamento / maxVal * 100) : 0;
                    return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.6rem">
                        <span style="font-size:1.1rem;font-weight:700;color:#1e3c72">${fmt(m.faturamento)}</span>
                        <div style="width:100%;background:#f0f2f5;border-radius:.4rem .4rem 0 0;height:${Math.max(pct, 4)}%;min-height:4px;background:linear-gradient(180deg,#1e3c72,#3b6bc9);transition:height .6s"></div>
                        <span style="font-size:1.1rem;color:#6b7280">${m.mes}</span>
                    </div>`;
                }).join("");
            }
        }

        async function gerarInsight(tipo, btn) {
            const box = document.getElementById(`insight-${tipo}`);
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Analisando dados...';
            box.className = "insight-box carregando";
            box.textContent = "⏳ Analisando seus dados em tempo real...";

            try {
                const res = await fetch("/ML/Insight", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ tipo })
                });
                const data = await res.json();
                box.className = "insight-box";
                box.textContent = data.insight;
            } catch(err) {
                box.className = "insight-box";
                box.textContent = "Erro ao gerar análise. Tente novamente.";
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-stars"></i> Atualizar análise';
            }
        }

        function recarregar() {
            dadosML = null;
            document.querySelectorAll(".insight-box").forEach(b => {
                b.textContent = 'Clique em "Gerar análise IA" para obter insights.';
            });
            carregarDados();
        }

        // Auto-atualiza a cada 5 minutos
        carregarDados();
        setInterval(carregarDados, 5 * 60 * 1000);
    </script>
</body>
</html>